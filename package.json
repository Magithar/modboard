{
  "name": "modboard",
  "version": "0.6.0",
  "description": "A task board several coding agents share, through one CLI",
  "type": "module",
  "bin": { "board": "bin/board.mjs" },
  "exports": {
    "./lib/contract.mjs": "./lib/contract.mjs",
    "./lib/engine.mjs": "./lib/engine.mjs",
    "./lib/store-file.mjs": "./lib/store-file.mjs",
    "./examples/store-memory.mjs": "./examples/store-memory.mjs",
    "./package.json": "./package.json"
  },
  "files": ["bin/", "lib/", "examples/", "hooks/", "types/", ".claude-plugin/plugin.json", "tsconfig.json", "README.md", "CHANGELOG.md", "ROADMAP.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:mod": "claude plugin test .",
    "prepublishOnly": "npm test"
  },
  "keywords": ["modboard", "claude", "claude-code", "claude-code-plugin", "codex", "opencode", "llm-agents", "coding-agents", "multi-agent", "agent-coordination", "task-board", "kanban", "cli"],
  "repository": { "type": "git", "url": "git+https://github.com/Magithar/modboard.git" },
  "engines": { "node": ">=18" },
  "license": "MIT"
}
